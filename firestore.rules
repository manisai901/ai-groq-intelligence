rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidGlobalStats(data) {
      return data.keys().hasAll(['totalUsers', 'totalVisits']) 
        && data.keys().size() == 2
        && data.totalUsers is int
        && data.totalVisits is int;
    }

    function isValidDailyStats(data) {
      return data.keys().hasAll(['uniqueUsers', 'visits', 'date'])
        && data.keys().size() == 3
        && data.uniqueUsers is int
        && data.visits is int
        && data.date is string;
    }

    match /stats/{docId} {
      allow read: if true;
      allow create: if docId == 'global' && isValidGlobalStats(request.resource.data);
      allow update: if docId == 'global' 
        && isValidGlobalStats(request.resource.data)
        && request.resource.data.totalUsers >= resource.data.totalUsers
        && request.resource.data.totalVisits >= resource.data.totalVisits;
    }

    match /daily_stats/{date} {
      allow read: if true;
      allow create: if isValidDailyStats(request.resource.data) && date == request.resource.data.date;
      allow update: if isValidDailyStats(request.resource.data)
        && request.resource.data.uniqueUsers >= resource.data.uniqueUsers
        && request.resource.data.visits >= resource.data.visits;
    }
  }
}
