{
  "entities": {
    "GlobalStats": {
      "title": "Global Stats",
      "description": "Aggregated application usage statistics",
      "type": "object",
      "properties": {
        "totalUsers": { "type": "number" },
        "totalVisits": { "type": "number" }
      },
      "required": ["totalUsers", "totalVisits"]
    },
    "DailyStats": {
      "title": "Daily Stats",
      "description": "Statistics for a specific day",
      "type": "object",
      "properties": {
        "uniqueUsers": { "type": "number" },
        "visits": { "type": "number" },
        "date": { "type": "string", "format": "date" }
      },
      "required": ["uniqueUsers", "visits", "date"]
    },
    "User": {
      "title": "User Profile",
      "description": "User account information from Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Conversation": {
      "title": "Chat Conversation",
      "description": "Metadata for a specific chat thread.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Individual message within a conversation.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/stats/global": {
      "schema": "GlobalStats",
      "description": "Global usage counters"
    },
    "/daily_stats/{date}": {
      "schema": "DailyStats",
      "description": "Daily usage counters indexed by date"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles restricted to the owner."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat thread metadata owned by a user."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages belonging to a conversation."
    }
  }
}
